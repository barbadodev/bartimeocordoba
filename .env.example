APP_NAME="Bartimeo Córdoba"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bartimeo
DB_USERNAME=bartimeo
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

BARTIMEO_ORIGENES=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173
COORDINACION_LINK_HASH=
PUBLIC_REGISTRATION_LIMIT=300
