APP_NAME="Bartimeo Córdoba"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bartimeocordoba.org
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bartimeo
DB_USERNAME=bartimeo
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

BARTIMEO_ORIGENES=https://bartimeocordoba.org,https://www.bartimeocordoba.org
COORDINACION_LINK_HASH=
PUBLIC_REGISTRATION_LIMIT=300
